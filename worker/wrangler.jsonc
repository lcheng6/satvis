{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "satvis",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  // celestrak.org is itself behind Cloudflare. Without this flag a Worker's
  // fetch() to another Cloudflare-proxied host is routed internally
  // ("orange-to-orange"), which times out with HTTP 522 — even though the same
  // URL fetches fine from the public internet. This flag forces fetch() out to
  // Cloudflare's public front door, matching a normal client. It is not on by
  // default at any compatibility_date, so it must be set explicitly.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "send_metrics": false,
  "routes": [
    {
      "pattern": "satvis.space",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "../dist",
    "not_found_handling": "single-page-application",
    // Route /api/* to the Worker first; otherwise the SPA not_found_handling
    // fallback swallows the API routes and serves index.html.
    // /__scheduled is the wrangler-dev cron test endpoint (--test-scheduled);
    // it must also bypass the SPA fallback to reach the Worker.
    "run_worker_first": ["/api/*", "/__scheduled"],
  },
  "kv_namespaces": [{ "binding": "GP_KV", "id": "26a7848ab641416fa518a3df4790a968" }],
  // Databricks connection. Empty here on purpose: with all three of HOST /
  // WAREHOUSE_ID / TOKEN blank the integration reports itself "not configured"
  // and the worker keeps serving CelesTrak data unchanged. Set the two vars
  // below per environment (or in worker/.dev.vars for local dev) and the token
  // with `wrangler secret put DATABRICKS_TOKEN` — never as a var, which would
  // put it in plaintext in this file. Setting only some of them is a loud
  // failure, not a silent downgrade (see src/databricks/config.ts).
  "vars": {
    "DATABRICKS_HOST": "",
    "DATABRICKS_WAREHOUSE_ID": "",
    // Overrides the SCD2 elset table; blank uses DEFAULT_ELSET_TABLE.
    "DATABRICKS_ELSET_TABLE": "",
    // Overrides the satcat dimension joined LEFT for names and launch dates;
    // blank uses DEFAULT_SATCAT_TABLE.
    "DATABRICKS_SATCAT_TABLE": "",
    // "1" exposes GET /api/databricks/probe. Off in production: the endpoint is
    // unauthenticated and every call spins a metered SQL warehouse.
    "DATABRICKS_PROBE": "0",
  },
  "triggers": {
    // Every 3 h at :23 (>= CelesTrak's ~2 h refresh guidance, off-hour minute).
    "crons": ["23 */3 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
